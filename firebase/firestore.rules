rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Role checked against Firestore document (not custom claims).
    // For performance-critical rules, use hasCustomClaim() instead.
    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated()
        && exists(userPath)
        && get(userPath).data.role == 'admin';
    }

    // Role checked against Firebase Auth custom claims — no Firestore read needed.
    // Set custom claims via Admin SDK: adminAuth.setCustomUserClaims(uid, { admin: true })
    function hasCustomClaim(claim) {
      return isAuthenticated() && request.auth.token[claim] == true;
    }

    // Soft-delete guard — filters out logically deleted documents.
    // Include in read rules: allow read: if isOwner(userId) && notDeleted();
    function notDeleted() {
      return resource == null || !('deletedAt' in resource.data) || resource.data.deletedAt == null;
    }

    // ── Collections ────────────────────────────────────────────────────────

    // users/{userId}
    // Each user can only read and update their own profile.
    // Admins can read any profile.
    // Creation is triggered by AuthProvider on first sign-in (syncUserProfile).
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin()) && notDeleted();

      allow create: if isAuthenticated() && isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'email', 'role', 'createdAt', 'updatedAt', '_schemaVersion'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt', '_schemaVersion'])
        && request.resource.data.role == 'user';  // only admin SDK can set 'admin' role

      allow update: if isAuthenticated() && isOwner(userId)
        && request.resource.data.uid == resource.data.uid    // uid is immutable
        && request.resource.data.role == resource.data.role  // role is immutable by user
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt', '_schemaVersion']);

      allow delete: if false; // soft-delete only — set deletedAt field instead
    }

    // Maintenance writes use the client SDK, so these rules are the server-side authority.
    function validTransition(before, after) {
      return (before == 'OPEN' && after == 'IN_PROGRESS')
        || (before == 'IN_PROGRESS' && after == 'COMPLETED');
    }

    function validMaintenance(data) {
      return data.keys().hasAll(['pendantId', 'problemType', 'description', 'status',
          'createdBy', 'createdAt', 'updatedAt', 'lastHistoryId', '_schemaVersion'])
        && data.keys().hasOnly(['pendantId', 'problemType', 'description', 'status',
          'createdBy', 'createdAt', 'updatedAt', 'lastHistoryId', '_schemaVersion'])
        && data.pendantId in ['P001', 'P002', 'P003', 'P004', 'P005']
        && data.problemType in ['NO_SIGNAL', 'BATTERY', 'DAMAGE', 'OTHER']
        && data.description is string
        && data.description.size() >= 10 && data.description.size() <= 500
        && data.description.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && data.status in ['OPEN', 'IN_PROGRESS', 'COMPLETED']
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.lastHistoryId is string && data._schemaVersion == 1;
    }

    function matchingHistory(requestId, beforeStatus, data) {
      let entryPath = /databases/$(database)/documents/statusHistory/$(data.lastHistoryId);
      let entry = getAfter(entryPath).data;
      return data.lastHistoryId == requestId + '_' + data.status
        && !exists(entryPath)
        && entry.requestId == requestId
        && entry.fromStatus == beforeStatus && entry.toStatus == data.status
        && entry.changedBy == request.auth.uid && entry.changedAt == request.time;
    }

    match /maintenanceRequests/{requestId} {
      allow read: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      allow create: if isAuthenticated() && validMaintenance(request.resource.data)
        && request.resource.data.status == 'OPEN'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && matchingHistory(requestId, null, request.resource.data);
      allow update: if isAuthenticated() && resource.data.createdBy == request.auth.uid
        && validMaintenance(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'lastHistoryId'])
        && validTransition(resource.data.status, request.resource.data.status)
        && request.resource.data.updatedAt == request.time
        && matchingHistory(requestId, resource.data.status, request.resource.data);
      allow delete: if false;
    }

    function matchingRequest(entryId, entry) {
      let parentPath = /databases/$(database)/documents/maintenanceRequests/$(entry.requestId);
      let parent = getAfter(parentPath).data;
      return parent.createdBy == request.auth.uid
        && parent.lastHistoryId == entryId && parent.status == entry.toStatus
        && parent.updatedAt == request.time
        && ((!exists(parentPath) && entry.fromStatus == null && entry.toStatus == 'OPEN')
          || (exists(parentPath)
            && get(parentPath).data.status == entry.fromStatus
            && validTransition(entry.fromStatus, entry.toStatus)));
    }

    match /statusHistory/{entryId} {
      allow read: if isAuthenticated() && resource.data.changedBy == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['requestId', 'fromStatus', 'toStatus',
          'changedBy', 'changedAt', '_schemaVersion'])
        && request.resource.data.keys().hasOnly(['requestId', 'fromStatus', 'toStatus',
          'changedBy', 'changedAt', '_schemaVersion'])
        && request.resource.data.requestId is string
        && request.resource.data.changedBy == request.auth.uid
        && request.resource.data.changedAt == request.time
        && request.resource.data._schemaVersion == 1
        && entryId == request.resource.data.requestId + '_' + request.resource.data.toStatus
        && matchingRequest(entryId, request.resource.data);
      allow update, delete: if false;
    }


    // ── Default deny ───────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
